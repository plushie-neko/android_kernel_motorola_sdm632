	fragment@22 {
		target = <&soc>;

		__overlay__ {

			dsi_panel_pwr_supply: dsi_panel_pwr_supply {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				qcom,panel-supply-entry@0 {
					reg = <0x01>;
					qcom,supply-name = "vddio";
					qcom,supply-min-voltage = <0x1b7740>;
					qcom,supply-max-voltage = <0x1b7740>;
					qcom,supply-enable-load = <0x186a0>;
					qcom,supply-disable-load = <0x64>;
				};

				qcom,panel-supply-entry@1 {
					reg = <0x02>;
					qcom,supply-name = "lab";
					qcom,supply-min-voltage = <0x4630c0>;
					qcom,supply-max-voltage = <0x5b8d80>;
					qcom,supply-enable-load = <0x186a0>;
					qcom,supply-disable-load = <0x64>;
				};

				qcom,panel-supply-entry@2 {
					reg = <0x03>;
					qcom,supply-name = "ibb";
					qcom,supply-min-voltage = <0x4630c0>;
					qcom,supply-max-voltage = <0x5b8d80>;
					qcom,supply-enable-load = <0x186a0>;
					qcom,supply-disable-load = <0x64>;
					qcom,supply-post-on-sleep = <0x0a>;
				};
			};
		};
	};

	fragment@23 {
		target = <&mdss_mdp>;

		__overlay__ {
			qcom,mdss-pref-prim-intf = "dsi";
		};
	};

	fragment@24 {
		target = <&mdss_dsi>;

		__overlay__ {
			hw-config = "single_dsi";
		};
	};

	fragment@25 {
		target = <&mdss_dsi0>;

		__overlay__ {
			qcom,dsi-pref-prim-pan = <&dsi_truly_1080_vid>;
			pinctrl-names = "mdss_default", "mdss_sleep";
			pinctrl-0 = <&mdss_dsi_active>, <&mdss_te_active>;
			pinctrl-1 = <&mdss_dsi_suspend>, <&mdss_te_suspend>;
			qcom,platform-te-gpio = <&tlmm>, <0x18 0x00>;
			qcom,platform-reset-gpio = <&tlmm>, <0x3d 0x00>;
			qcom,platform-bklight-en-gpio = <&tlmm>, <0x3b 0x00>;
		};
	};

	fragment@26 {
		target = <&mdss_dsi1>;

		__overlay__ {
			status = "disabled";
			qcom,dsi-pref-prim-pan = <&dsi_adv7533_1080p>;
			pinctrl-names = "mdss_default", "mdss_sleep";
			pinctrl-0 = <&mdss_dsi_active>, <&mdss_te_active>;
			pinctrl-1 = <&mdss_dsi_suspend>, <&mdss_te_suspend>;
			qcom,pluggable;
			qcom,platform-te-gpio = <&tlmm>, <0x18 0x00>;
			qcom,platform-reset-gpio = <&tlmm>, <0x3d 0x00>;
			qcom,platform-bklight-en-gpio = <&tlmm>, <0x3b 0x00>;
		};
	};

	fragment@27 {
		target = <&soc>;

		__overlay__ {

			gpio_keys {
				compatible = "gpio-keys";
				input-name = "gpio-keys";
				pinctrl-names = "default";
				pinctrl-0 = <&gpio_key_active>;

				camera_focus {
					label = "camera_focus";
					gpios = <&tlmm>, <0x57 0x01>;
					linux,input-type = <0x01>;
					linux,code = <0x210>;
					debounce-interval = <0x0f>;
					linux,can-disable;
					gpio-key,wakeup;
				};

				camera_snapshot {
					label = "camera_snapshot";
					gpios = <&tlmm>, <0x56 0x01>;
					linux,input-type = <0x01>;
					linux,code = <0x2fe>;
					debounce-interval = <0x0f>;
					linux,can-disable;
					gpio-key,wakeup;
				};

				vol_up {
					label = "volume_up";
					gpios = <&tlmm>, <0x55 0x01>;
					linux,input-type = <0x01>;
					linux,code = <0x73>;
					debounce-interval = <0x0f>;
					linux,can-disable;
					gpio-key,wakeup;
				};
			};

			hall {
				compatible = "hall-switch";
				pinctrl-names = "default";
				pinctrl-0 = <&hall_sensor_int_default>;
				interrupt-parent = <&tlmm>;
				interrupts = <0x0d 0x2003>;
				linux,gpio-int = <&tlmm>, <0x0d 0x01>;
				linux,wakeup;
				linux,min-uv = <0x192d50>;
				linux,max-uv = <0x325aa0>;
			};
		};
	};

	fragment@28 {
		target = <&thermal_zones>;

		__overlay__ {

			case-therm-step {
				status = "disabled";
			};

			quiet-therm-step {
				status = "disabled";
			};

			sdm632-skin-step {
				status = "disabled";
			};
		};
	};

	fragment@29 {
		target = <&rpm_bus>;

		__overlay__ {

