			interrupt-parent = <&sdhc_2>;
			interrupts = <0x00 0x01 0x02>;
			#interrupt-cells = <0x01>;
			interrupt-map-mask = <0xffffffff>;
			interrupt-map = <0x00>, <&intc>, <0x00 0x7d 0x00 0x01>, <&intc>, <0x00 0xdd 0x00 0x02>, <&tlmm>, <0x85 0x00>;
			interrupt-names = "hc_irq", "pwr_irq", "status_irq";
			cd-gpios = <&tlmm>, <0x85 0x00>;
			qcom,clk-rates = <0x61a80 0x1312d00 0x17d7840 0x2faf080 0x5f5e100 0xbebc200>;
			qcom,bus-speed-mode = "SDR12", "SDR25", "SDR50", "DDR50", "SDR104";
			status = "ok";
		};
	};

